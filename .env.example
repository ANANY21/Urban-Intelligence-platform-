# ==============================================================================
# CHENNAI URBAN INTELLIGENCE PLATFORM — CONFIGURATION ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and configure secrets and credentials.
# NEVER commit .env to version control or expose secrets in frontend client code.

# ------------------------------------------------------------------------------
# 1. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Secret key for signing JWT access and refresh tokens (use openssl rand -hex 32)
SECRET_KEY=9f82d8c3b4a5e6f71029384756abcdef0123456789abcdef0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false  # Set to true in production HTTPS environments
COOKIE_SAMESITE=lax

# Initial Administrator Account (automatically seeded on first launch if users table is empty)
INITIAL_ADMIN_EMAIL=admin@chennai-urban.gov.in
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@Chennai2026!

# ------------------------------------------------------------------------------
# 2. DATABASE & VECTOR STORAGE
# ------------------------------------------------------------------------------
DATABASE_PATH=backend/urban_intelligence.db
VECTOR_STORE_TYPE=sqlite  # 'sqlite' persistent cosine vector store
UPLOADS_DIR=backend/uploads

# ------------------------------------------------------------------------------
# 3. LLM PROVIDER & RAG CONFIGURATION
# ------------------------------------------------------------------------------
# LLM Provider options:
# - 'local': Pure local grounded generation using verified RAG knowledge base & ML tools (Zero API cost, offline capable)
# - 'openai': Requires OPENAI_API_KEY (e.g. gpt-4o, gpt-4o-mini)
# - 'gemini': Requires GEMINI_API_KEY (e.g. gemini-1.5-flash, gemini-2.0-flash)
LLM_PROVIDER=local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding Provider options:
# - 'local': Pure local TF-IDF & dense L2-normalized cosine vectors (zero external dependency)
# - 'openai': text-embedding-3-small (requires OPENAI_API_KEY)
# - 'gemini': text-embedding-004 (requires GEMINI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
RAG_SIMILARITY_THRESHOLD=0.15
RAG_TOP_K=4

# ------------------------------------------------------------------------------
# 4. KAFKA & STREAMING INFRASTRUCTURE
# ------------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:29092
DEFAULT_DATA_MODE=demo
REPLAY_DEFAULT_SPEED=1.0

# ------------------------------------------------------------------------------
# 5. FRONTEND & CORS
# ------------------------------------------------------------------------------
FRONTEND_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
